{
  "name": "@idea2app/ows",
  "version": "4.0.0",
  "description": "React project scaffold based on TypeScript, Next.js, Bootstrap & Serwist.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.75",
    "@giscus/react": "^3.1.0",
    "@khmyznikov/pwa-install": "^0.7.0",
    "@koa/bodyparser": "^6.1.0",
    "@passwordless-id/webauthn": "^2.4.0",
    "@sentry/nextjs": "^10.75.0",
    "@serwist/next": "^9.5.12",
    "ai": "^7.0.106",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "core-js": "^3.50.0",
    "file-type": "^22.1.1",
    "idb-keyval": "^6.3.0",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.1",
    "koa-jwt": "^4.0.4",
    "koajax": "^3.3.1",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "mime": "^4.1.0",
    "mobx": "^7.0.3",
    "mobx-github": "^0.7.1",
    "mobx-i18n": "^0.7.9",
    "mobx-lark": "^2.10.1",
    "mobx-react": "^10.0.2",
    "mobx-react-helper": "^0.5.4",
    "mobx-restful": "^2.1.5",
    "next": "16.3.5",
    "next-ssr-middleware": "^1.1.5",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-utility": "^4.7.2",
    "webpack": "^5.111.1"
  },
  "devDependencies": {
    "@idea2app/data-server": "^1.0.0-rc.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^3.0.3",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-idea2app-next-js": "^0.1.1",
    "git-utility": "^0.3.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-helper": "^0.5.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "next": "$next"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "tabWidth": 2,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-css-order",
      "prettier-plugin-tailwindcss"
    ]
  },
  "lint-staged": {
    "*.{html,md,less,json,yml,js,mjs,ts,tsx}": "prettier --write"
  },
  "scripts": {
    "e": "pnpx @dotenvx/dotenvx run -f .env.personal.local -- pnpm",
    "prepare": "husky || true",
    "install": "xgit download https://github.com/idea2app/key-vault main idea2app.github.io  ||  true",
    "postinstall": "shadcn-helper install  &&  next typegen --webpack",
    "dev": "next dev --webpack",
    "build": "cross-env CI=true  next build --webpack",
    "start": "next start",
    "test": "lint-staged  &&  tsc --noEmit",
    "pack-image": "docker build -t idea2app/web-server .",
    "container": "docker rm -f web-server  &&  docker run --name web-server -p 3000:3000 -d idea2app/web-server"
  }
}
