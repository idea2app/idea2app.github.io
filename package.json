{
  "name": "@idea2app/ows",
  "version": "4.0.0",
  "description": "React project scaffold based on TypeScript, Next.js, Bootstrap & Workbox.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.31",
    "@giscus/react": "^3.1.0",
    "@koa/bodyparser": "^6.1.0",
    "@passwordless-id/webauthn": "^2.4.0",
    "@sentry/nextjs": "^10.69.0",
    "ai": "^7.0.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "core-js": "^3.49.0",
    "file-type": "^22.0.1",
    "idb-keyval": "^6.3.0",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.1",
    "koa-jwt": "^4.0.4",
    "koajax": "^3.3.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.7",
    "mime": "^4.1.0",
    "mobx": "^6.16.1",
    "mobx-github": "^0.7.0",
    "mobx-i18n": "^0.7.5",
    "mobx-lark": "^2.10.0",
    "mobx-react": "^9.2.2",
    "mobx-react-helper": "^0.5.1",
    "mobx-restful": "^2.1.4",
    "next": "16.3.0",
    "next-pwa": "~5.6.0",
    "next-ssr-middleware": "^1.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-utility": "^4.7.2",
    "webpack": "^5.109.2"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.0.1",
    "@eslint/js": "^10.0.1",
    "@idea2app/data-server": "^1.0.0-rc.11",
    "@next/eslint-plugin-next": "16.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^3.0.3",
    "@types/lodash.debounce": "^4.0.9",
    "@types/next-pwa": "^5.6.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "git-utility": "^0.3.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-helper": "^0.5.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "resolutions": {
    "next": "$next"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "tabWidth": 2,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-css-order",
      "prettier-plugin-tailwindcss"
    ]
  },
  "lint-staged": {
    "*.{html,md,less,json,yml,js,mjs,ts,tsx}": "prettier --write"
  },
  "scripts": {
    "e": "pnpx @dotenvx/dotenvx run -f .env.personal.local -- pnpm",
    "prepare": "husky || true",
    "install": "xgit download https://github.com/idea2app/key-vault main idea2app.github.io  ||  true",
    "postinstall": "shadcn-helper install  &&  next typegen",
    "dev": "next dev --webpack",
    "build": "cross-env CI=true  next build --webpack",
    "start": "next start",
    "test": "lint-staged  &&  tsc --noEmit",
    "pack-image": "docker build -t idea2app/web-server .",
    "container": "docker rm -f web-server  &&  docker run --name web-server -p 3000:3000 -d idea2app/web-server"
  }
}
